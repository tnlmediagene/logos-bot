{
  // logos-bot on Cloudflare Workers.
  // Stage 1 scaffold: boots an empty `export default { fetch }` shell with the
  // D1 + KV bindings the later stages need. Secrets are set with
  // `wrangler secret put` (see .dev.vars.example for local dev), NOT here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logos-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  // svg2png-wasm / photon and standard byte handling want Node compat shims.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Cloudflare D1 — replaces the local better-sqlite3 catalog.db.
  // Create with:  wrangler d1 create logos-bot-catalog
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logos-bot-catalog",
      "database_id": "01b983c0-98b8-4d51-ab10-6c29e97333e7",
      "migrations_dir": "migrations"
    }
  ],

  // KV — replaces the in-memory ConversationStore (per-user dialog state, TTL'd).
  // Create with:  wrangler kv namespace create CONVERSATIONS
  // then paste the returned id below.
  //
  // INSTALLATIONS — multi-workspace OAuth installs (bot token per team), via
  // KVInstallationStore. Separate from CONVERSATIONS: installs persist
  // indefinitely, conversation state doesn't.
  // Create with:  wrangler kv namespace create INSTALLATIONS
  "kv_namespaces": [
    {
      "binding": "CONVERSATIONS",
      "id": "9b734636eac04572bc3183c33b55fc83"
    },
    {
      "binding": "INSTALLATIONS",
      "id": "REPLACE_WITH_INSTALLATIONS_KV_NAMESPACE_ID"
    }
  ],

  // Cloudflare Images binding — the sharp replacement for resize + composite.
  // Used only on custom-size renders; the SVG natural-PNG path is pure WASM.
  "images": { "binding": "IMAGES" },

  // Non-secret configuration. Secrets (SLACK_SIGNING_SECRET, SLACK_CLIENT_ID,
  // SLACK_CLIENT_SECRET, GOOGLE_SERVICE_ACCOUNT_KEY, and the now-optional
  // SLACK_BOT_TOKEN fallback) are injected via `wrangler secret put`.
  // (SLACK_CLIENT_ID isn't actually secret — it's visible in the install URL —
  // but it's set as a secret here too, so it must NOT also appear as a var:
  // a name can't be both at once.)
  "vars": {
    "AI_PROVIDER": "vertex",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "MAX_OUTPUT_SIZE": "4096",
    "DRIVE_ROOT_FOLDER_ID": "1Y6avk_W5jRsl5Ab-PWiBvOo_AFGoFEv2",
    "VERTEX_PROJECT_ID": "logos-bot-515608",
    "VERTEX_LOCATION": "us-central1",
    "AUDIT_NOTIFY_CHANNELS": "",

    // --- OAuth app-installation (SlackOAuthApp) ---
    // Comma-separated bot scopes requested on install. Must match (or be a
    // subset of) what the Slack App's OAuth & Permissions page has configured.
    "SLACK_BOT_SCOPES": "chat:write,files:write,im:history",
    // Must exactly match a Redirect URL registered on the Slack App's
    // OAuth & Permissions page.
    "SLACK_REDIRECT_URI": "https://logos-bot.thenewslens.workers.dev/slack/oauth_redirect"
  }
}
