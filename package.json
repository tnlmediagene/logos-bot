{
  "name": "logos-bot",
  "version": "1.0.0",
  "description": "Slack bot for requesting brand logo assets via natural language",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply logos-bot-catalog --local",
    "db:migrate:remote": "wrangler d1 migrations apply logos-bot-catalog --remote",
    "scan": "tsx src/scan.ts",
    "scan:full": "tsx src/scan.ts --full",
    "sync:d1": "tsx src/sync/sync-to-d1.ts",
    "sync:d1:local": "tsx src/sync/sync-to-d1.ts --local",
    "sync:d1:remote": "tsx src/sync/sync-to-d1.ts --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "slack-cloudflare-workers": "^1.3.6",
    "svg2png-wasm": "1.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4"
  }
}
