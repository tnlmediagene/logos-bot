{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/worker.ts",
    "src/env.ts",
    "src/slack-app.ts",
    "src/wasm.d.ts",
    "src/bot/worker-message-handler.ts",
    "src/bot/worker-audit.ts",
    "src/bot/kv-conversation-store.ts",
    "src/catalog/d1-catalog-repo.ts",
    "src/renderer/worker-renderer.ts",
    "src/index.ts",
    "src/bot/app.ts",
    "src/bot/commands.ts",
    "src/bot/dm-handler.ts",
    "src/bot/delivery.ts"
  ]
}
