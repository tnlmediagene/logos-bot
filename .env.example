# Env for the offline `scan` pipeline only (`pnpm scan`). The live bot is a
# Cloudflare Worker and doesn't read this file — see wrangler.jsonc / .dev.vars.example.

# Google 金鑰：擇一。推薦用檔案路徑（把 .json 放在 repo 外，不要 commit）。
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}   # 備用：整包貼上
DRIVE_ROOT_FOLDER_ID=...
DATABASE_PATH=./data/catalog.db
