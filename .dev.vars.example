# Local dev secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and fill in.
# Production secrets are set with `wrangler secret put <NAME>` instead.

# Optional: with OAuth installs (SlackOAuthApp), each workspace's bot token
# comes from the INSTALLATIONS KV instead. Only needed as a manual fallback.
SLACK_BOT_TOKEN="xoxb-..."
SLACK_SIGNING_SECRET="..."
# Slack App → Basic Information → App Credentials.
SLACK_CLIENT_ID="..."
SLACK_CLIENT_SECRET="..."
# Full service-account JSON as a single-line string:
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account", ...}'
